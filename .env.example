# VistoFlow Pro - configurazione opzionale della ricerca online.
# Copia questo file in .env e inserisci la tua chiave TMDB v3.
# La chiave può anche essere inserita dalla GUI: Ricerca online -> ⋯ -> Imposta chiave TMDB.

TMDB_API_KEY=
TMDB_LANGUAGE=it-IT
CHANNELS_DIR=channels
HTTP_TIMEOUT=15
CHANNEL_TIMEOUT=20
RESOLVER_TIMEOUT=25
MAX_CONCURRENCY=8
LOG_LEVEL=INFO
