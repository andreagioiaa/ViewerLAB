<!-- Installer .msi di ViewerLAB (WiX Toolset 5): lo crea build_exe.py con l'opzione msi.
     Installa per il solo utente in %LOCALAPPDATA%\Programs\ViewerLAB, senza
     permessi di amministratore: l'app scrive i suoi dati accanto all'exe
     (visto_settings.json, covers/), cosa impossibile in Program Files. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ViewerLAB" Manufacturer="ViewerLAB" Version="$(Version)"
           UpgradeCode="e3d75575-cb95-4a64-9b3a-4fcd7e0828f2" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="È già installata una versione più recente di ViewerLAB." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ViewerLAB.ico" SourceFile="!(bindpath.app)\ViewerLAB.exe" />
    <Property Id="ARPPRODUCTICON" Value="ViewerLAB.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ViewerLAB" />
      </Directory>
    </StandardDirectory>

    <!-- tutta la cartella dist\ViewerLAB creata da PyInstaller -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.app)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="ViewerLABShortcut" Name="ViewerLAB"
                  Target="[INSTALLFOLDER]ViewerLAB.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ViewerLAB" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
