# Copia questo file in .env e compila i valori necessari.

# Chiave API TMDB v3 (opzionale: senza chiave i risultati non sono arricchiti)
TMDB_API_KEY=

# Lingua preferita per i metadati (fallback automatico su en-US)
TMDB_LANGUAGE=it-IT

# Cartella dei canali JSON/YAML (default: ./channels)
CHANNELS_DIR=channels

# Timeout HTTP in secondi
HTTP_TIMEOUT=15
CHANNEL_TIMEOUT=20
RESOLVER_TIMEOUT=25

# Numero massimo di richieste contemporanee
MAX_CONCURRENCY=8

# User-Agent usato dal client HTTP e restituito nei flussi
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) MediaCenterCLI/0.1

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
